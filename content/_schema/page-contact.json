        },
        {
          "name": "title",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "lead",
          "label": "Introduction",
          "type": "textarea"
        },
        {
          "name": "art",
          "label": "Background pattern",
          "type": "number",
          "min": 0,
          "max": 5,
