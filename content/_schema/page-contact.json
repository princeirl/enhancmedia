        }
      ]
    },
    {
      "name": "officeLabel",
      "label": "Address label",
      "type": "text"
    },
    {
      "name": "consultation",
      "label": "Consultation box",
      "type": "object",
      "fields": [
        {
          "name": "heading",
          "label": "Heading",
          "type": "text",
