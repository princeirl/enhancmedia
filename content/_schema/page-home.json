        },
        {
          "name": "link",
          "label": "Link",
          "type": "link"
        }
      ]
    },
    {
      "name": "services",
      "label": "What we do",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "heading",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea"
