{
  "$format": 1,
  "id": "page-home",
  "label": "Home",
  "group": "Pages",
  "order": 10,
  "kind": "object",
  "file": "content/pages/home.json",
  "preview": "/",
  "fields": [
    {
      "name": "seo",
      "label": "Search & sharing",
      "type": "object",
      "fields": [
        {
          "name": "title",
          "label": "Page title",
          "type": "text",
          "nullable": true,
          "help": "Shown in the browser tab and search results. Empty uses the site name and tagline."
        },
        {
          "name": "description",
          "label": "Description",
          "type": "textarea",
          "required": true,
          "max": 300,
          "help": "One or two sentences for search results."
        }
      ]
    },
    {
      "name": "hero",
      "label": "Hero",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "headline",
          "label": "Headline lines",
          "type": "list",
          "of": {
            "name": "line",
            "label": "Line",
            "type": "text"
          },
          "help": "The last line is shown in gold."
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "name": "primary",
          "label": "First button",
          "type": "link"
        },
        {
          "name": "secondary",
          "label": "Second button",
          "type": "link"
        },
        {
          "name": "pillars",
          "label": "Words along the bottom",
          "type": "list",
          "of": {
            "name": "word",
            "label": "Word",
            "type": "text"
          }
        }
      ]
    },
    {
      "name": "intro",
      "label": "Who we are",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "heading",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "lead",
          "label": "Lead",
          "type": "textarea"
        },
        {
          "name": "body",
          "label": "Body",
          "type": "textarea"
        },
        {
          "name": "points",
          "label": "Points",
          "type": "list",
          "of": {
            "name": "item",
            "label": "Point",
            "type": "object",
            "fields": [
              {
                "name": "title",
                "label": "Title",
                "type": "text",
                "required": true
              },
              {
                "name": "text",
                "label": "Text",
                "type": "textarea"
              }
            ]
