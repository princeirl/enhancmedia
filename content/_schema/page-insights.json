{
  "$format": 1,
  "id": "page-insights",
  "label": "Insights",
  "group": "Pages",
  "order": 70,
  "kind": "object",
  "file": "content/pages/insights.json",
  "preview": "/insights",
  "fields": [
    {
      "name": "seo",
      "label": "Search & sharing",
      "type": "object",
      "fields": [
        {
          "name": "title",
          "label": "Page title",
          "type": "text",
          "nullable": true,
          "help": "Shown in the browser tab and search results. Empty uses the site name and tagline."
        },
        {
          "name": "description",
          "label": "Description",
          "type": "textarea",
          "required": true,
          "max": 300,
          "help": "One or two sentences for search results."
        }
      ]
    },
    {
      "name": "hero",
      "label": "Top of page",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "title",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "lead",
          "label": "Introduction",
          "type": "textarea"
        },
        {
          "name": "art",
          "label": "Background pattern",
          "type": "number",
          "min": 0,
          "max": 5,
          "help": "0–5: which abstract line drawing sits behind the heading."
        }
      ]
    },
    {
      "name": "empty",
      "label": "When no article is published",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "heading",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link"
        }
      ]
    }
  ]
}
