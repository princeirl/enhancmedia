{
  "$format": 1,
  "id": "page-work",
  "label": "Our Work",
  "group": "Pages",
  "order": 60,
  "kind": "object",
  "file": "content/pages/work.json",
  "preview": "/work",
  "fields": [
    {
      "name": "seo",
      "label": "Search & sharing",
      "type": "object",
      "fields": [
        {
          "name": "title",
          "label": "Page title",
          "type": "text",
          "nullable": true,
          "help": "Shown in the browser tab and search results. Empty uses the site name and tagline."
        },
        {
          "name": "description",
          "label": "Description",
          "type": "textarea",
          "required": true,
          "max": 300,
          "help": "One or two sentences for search results."
        }
      ]
    },
    {
      "name": "hero",
      "label": "Top of page",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "title",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "lead",
          "label": "Introduction",
          "type": "textarea"
        },
        {
          "name": "art",
          "label": "Background pattern",
          "type": "number",
          "min": 0,
          "max": 5,
          "help": "0–5: which abstract line drawing sits behind the heading."
        }
      ]
    },
    {
      "name": "categories",
      "label": "Portfolio categories",
      "type": "list",
      "of": {
        "name": "category",
        "label": "Category",
        "type": "text"
      },
      "help": "Each project picks one of these."
    },
    {
      "name": "filterAll",
      "label": "“All” filter label",
      "type": "text"
    },
    {
      "name": "filterLabel",
      "label": "Filter label (screen readers)",
      "type": "text"
    },
    {
      "name": "empty",
      "label": "When no project is published",
      "type": "object",
      "fields": [
        {
          "name": "eyebrow",
          "label": "Small label",
          "type": "text"
        },
        {
          "name": "heading",
          "label": "Heading",
          "type": "text",
          "required": true
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "name": "primary",
          "label": "First button",
          "type": "link"
        },
        {
          "name": "secondary",
          "label": "Second button",
          "type": "link"
        }
      ]
    }
  ]
}
