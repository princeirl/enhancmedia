{
  "name": "enhancmedia-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && next build",
    "build:preview": "npm run check:content && SITE_PREVIEW=1 next build",
    "deploy": "npm run check:launch && npm run build && wrangler deploy",
    "check:launch": "node scripts/prelaunch-check.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "preview": "npm run build:preview && wrangler dev",
    "check:content": "node scripts/check-content.mjs",
    "build:ci": "node scripts/ci.mjs build",
    "deploy:ci": "node scripts/ci.mjs deploy"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "18.1.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
