{
  // Enhanc Media website — one Worker: static assets from `out/`, plus /api/contact.
  // Built and deployed by Cloudflare Workers Builds from this repository (README → Deployment):
  //   main          → production, www.enhancmedia.com
  //   content-draft → a preview version, on its branch preview URL (admin panel saves land here)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enhancmedia-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Variables and secrets are set in the Cloudflare dashboard (Worker → Settings → Variables and
  // Secrets), never here. keep_vars stops a deploy from removing them. See README → "Inquiry form".
  //   CONTACT_TO, CONTACT_FROM, ALLOWED_ORIGINS   (text)
  //   RESEND_API_KEY (or BREVO_API_KEY), TURNSTILE_SECRET   (secrets)
  "keep_vars": true,
  "observability": { "enabled": true }
}
